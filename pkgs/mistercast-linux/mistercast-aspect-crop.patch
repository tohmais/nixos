+void CoreTest::aspectCropModes()
+{
+    // 8x2 source whose blue channel equals the column index.
+    constexpr std::uint32_t width = 8;
+    constexpr std::uint32_t height = 2;
+    std::vector<std::uint8_t> source(static_cast<std::size_t>(width) * height * 3, 0);
+    for (std::uint32_t y = 0; y < height; ++y) {
+        for (std::uint32_t x = 0; x < width; ++x) {
+            source[(static_cast<std::size_t>(y) * width + x) * 3] = static_cast<std::uint8_t>(x);
+        }
+    }
+    const SourceFrame frame{
+        source.data(), width, height, static_cast<std::int32_t>(width * 3), PixelFormat::Bgr};
+    std::vector<std::uint8_t> destination(static_cast<std::size_t>(width) * height * 3);
+
+    FramingSettings framing;
+    framing.aspect = AspectCrop::None;
+    QVERIFY(FrameProcessor::convertToBgr(executor_, frame, destination, width, height, framing));
+    for (std::uint32_t x = 0; x < width; ++x) {
+        QCOMPARE(destination[x * 3], static_cast<std::uint8_t>(x));
+    }
+
+    framing.aspect = AspectCrop::MatchOutput;
+    QVERIFY(FrameProcessor::convertToBgr(executor_, frame, destination, width, height, framing));
+    for (std::uint32_t x = 0; x < width; ++x) {
+        QCOMPARE(destination[x * 3], static_cast<std::uint8_t>(x));
+    }
+
+    // Default 4:3 still crops an 8x2 source to its centre (crop width 2: columns 3-4).
+    framing.aspect = AspectCrop::FourByThree;
+    QVERIFY(FrameProcessor::convertToBgr(executor_, frame, destination, width, height, framing));
+    QCOMPARE(destination[0], std::uint8_t{3});
+}
