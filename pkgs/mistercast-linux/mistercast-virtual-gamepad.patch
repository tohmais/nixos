--- /dev/null
+++ b/tests/VirtualGamepadTest.cpp
@@ -0,0 +1,337 @@
+#include "input/ControllerReceiver.h"
+#include "input/VirtualGamepad.h"
+#include <linux/uinput.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <cstdarg>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+using namespace mistercast;
+using namespace std::chrono_literals;
+using namespace controller_button;
+using Clock = std::chrono::steady_clock;
+
+// ---- Fake uinput: UI_* ioctls and writes on registered descriptors are recorded. ----
+namespace {
+struct FakeDevice {
+    std::set<int> evbits, keys, absbits;
+    std::vector<int> keyOrder;
+    std::map<int, input_absinfo> abs;
+    std::string phys;
+    uinput_setup setup{};
+    bool created{}, destroyed{};
+    std::vector<std::vector<input_event>> writes;
+    std::vector<Clock::time_point> writeTimes;
+};
+std::mutex fakeMutex;
+std::vector<FakeDevice> devices;
+std::map<int, std::size_t> deviceForFd;
+FakeDevice& deviceFor(int fd)
+{
+    auto it = deviceForFd.find(fd);
+    if (it == deviceForFd.end() || devices[it->second].destroyed || devices[it->second].created) {
+        devices.emplace_back();
+        it = deviceForFd.insert_or_assign(fd, devices.size() - 1).first;
+    }
+    return devices[it->second];
+}
+}
+extern "C" int __real_ioctl(int fd, unsigned long request, ...);
+extern "C" int __wrap_ioctl(int fd, unsigned long request, ...)
+{
+    va_list ap;
+    va_start(ap, request);
+    void* arg = va_arg(ap, void*);
+    va_end(ap);
+    const auto value = static_cast<int>(reinterpret_cast<std::intptr_t>(arg));
+    std::lock_guard lock(fakeMutex);
+    switch (request) {
+    case UI_SET_EVBIT: deviceFor(fd).evbits.insert(value); return 0;
+    case UI_SET_KEYBIT: { auto& d = devices[deviceForFd.at(fd)]; d.keys.insert(value); d.keyOrder.push_back(value); return 0; }
+    case UI_SET_ABSBIT: devices[deviceForFd.at(fd)].absbits.insert(value); return 0;
+    case UI_ABS_SETUP: {
+        const auto* s = static_cast<const uinput_abs_setup*>(arg);
+        devices[deviceForFd.at(fd)].abs[s->code] = s->absinfo;
+        return 0;
+    }
+    case UI_SET_PHYS: devices[deviceForFd.at(fd)].phys = static_cast<const char*>(arg); return 0;
+    case UI_DEV_SETUP: devices[deviceForFd.at(fd)].setup = *static_cast<const uinput_setup*>(arg); return 0;
+    case UI_DEV_CREATE: devices[deviceForFd.at(fd)].created = true; return 0;
+    case UI_DEV_DESTROY: devices[deviceForFd.at(fd)].destroyed = true; return 0;
+    default: return __real_ioctl(fd, request, arg);
+    }
+}
+extern "C" ssize_t __real_write(int fd, const void* buffer, std::size_t size);
+extern "C" ssize_t __wrap_write(int fd, const void* buffer, std::size_t size)
+{
+    {
+        std::lock_guard lock(fakeMutex);
+        const auto it = deviceForFd.find(fd);
+        if (it != deviceForFd.end() && devices[it->second].created && !devices[it->second].destroyed) {
+            const auto* events = static_cast<const input_event*>(buffer);
+            devices[it->second].writes.emplace_back(events, events + size / sizeof(input_event));
+            devices[it->second].writeTimes.push_back(Clock::now());
+            return static_cast<ssize_t>(size);
+        }
+    }
+    return __real_write(fd, buffer, size);
+}
+
+namespace {
+void check(bool condition, const char* message)
+{
+    if (!condition) throw std::runtime_error(message);
+}
+std::vector<std::uint8_t> packet(std::uint32_t frame, std::uint8_t order, std::uint16_t first,
+                                 std::uint16_t second, const std::array<std::int8_t, 8>* analog = nullptr)
+{
+    std::vector<std::uint8_t> bytes(analog ? 17 : 9, 0);
+    for (unsigned i = 0; i < 4; ++i) bytes[i] = (frame >> (8 * i)) & 255;
+    bytes[4] = order;
+    bytes[5] = first & 255; bytes[6] = first >> 8;
+    bytes[7] = second & 255; bytes[8] = second >> 8;
+    if (analog)
+        for (unsigned i = 0; i < 8; ++i) bytes[9 + i] = static_cast<std::uint8_t>((*analog)[i]);
+    return bytes;
+}
+std::vector<input_event> events(const GamepadState& from, const GamepadState& to)
+{
+    std::vector<input_event> result;
+    appendGamepadEvents(from, to, result);
+    return result;
+}
+bool has(const std::vector<input_event>& list, int type, int code, int value)
+{
+    return std::any_of(list.begin(), list.end(), [&](const input_event& e) {
+        return e.type == type && e.code == code && e.value == value;
+    });
+}
+
+void unitTests()
+{
+    // Analog bytes are signed, in LX LY RX RY order for controller 0 then 1.
+    const std::array<std::int8_t, 8> sticks{-127, 127, 1, -1, 10, 20, 30, -40};
+    auto p = decodeControllerPacket(packet(5, 1, Button1, Button2, &sticks));
+    check(p && p->hasAnalog && p->analog == sticks, "analog decode");
+    check(gamepadState(*p, 1).axes == std::array<std::int8_t, 4>{10, 20, 30, -40}, "controller 2 sticks");
+    p = decodeControllerPacket(packet(5, 1, Button1, 0));
+    check(p && !p->hasAnalog && gamepadState(*p, 0).axes == std::array<std::int8_t, 4>{}, "digital centres sticks");
+
+    // Button layout by position (RetroArch mister_joypad convention -> xpad codes).
+    const std::array<std::pair<std::uint16_t, int>, 8> keys{{
+        {Button1, BTN_A}, {Button2, BTN_B}, {Button3, BTN_X}, {Button4, BTN_Y},
+        {Button5, BTN_SELECT}, {Button6, BTN_START}, {LeftShoulder, BTN_TL}, {RightShoulder, BTN_TR}}};
+    for (auto [mask, code] : keys) {
+        auto e = events({}, {mask, {}});
+        check(e.size() == 1 && has(e, EV_KEY, code, 1), "button press code");
+        e = events({mask, {}}, {});
+        check(e.size() == 1 && has(e, EV_KEY, code, 0), "button release code");
+    }
+    check(has(events({}, {Button9, {}}), EV_ABS, ABS_Z, 255), "L2 -> left trigger");
+    check(has(events({Button10, {}}, {}), EV_ABS, ABS_RZ, 0), "R2 release -> right trigger");
+    auto e = events({}, {std::uint16_t(Up | Left), {}});
+    check(e.size() == 2 && has(e, EV_ABS, ABS_HAT0X, -1) && has(e, EV_ABS, ABS_HAT0Y, -1), "d-pad up-left hat");
+    check(events({}, {std::uint16_t(Left | Right), {}}).empty(), "opposing d-pad cancels");
+    check(has(events({Down, {}}, {Right, {}}), EV_ABS, ABS_HAT0Y, 0), "d-pad release");
+    e = events({}, {0, {127, -128, 0, 1}});
+    check(e.size() == 3 && has(e, EV_ABS, ABS_X, 32766) && has(e, EV_ABS, ABS_Y, -32768) &&
+          has(e, EV_ABS, ABS_RY, 258), "stick scaling");
+    check(events({Button1, {1, 2, 3, 4}}, {Button1, {1, 2, 3, 4}}).empty(), "unchanged state emits nothing");
+
+    // Ordering: newer accepted, duplicate and older rejected, rollover allowed, gap re-baselines.
+    ControllerSequence seq;
+    const auto t = Clock::now();
+    auto pk = [](std::uint32_t f, std::uint8_t o) { ControllerPacket x; x.frame = f; x.order = o; return x; };
+    check(seq.accept(pk(10, 5), t), "first snapshot");
+    check(!seq.accept(pk(10, 5), t) && !seq.accept(pk(10, 4), t) && !seq.accept(pk(9, 200), t), "stale accepted");
+    check(seq.accept(pk(10, 6), t) && seq.accept(pk(11, 0), t), "newer rejected");
+    ControllerSequence wrap;
+    check(wrap.accept(pk(0xffffffffu, 1), t) && wrap.accept(pk(0, 1), t), "frame rollover rejected");
+    check(!seq.accept(pk(3, 1), t + 999ms) && seq.accept(pk(3, 1), t + 2s), "counter reset never recovers");
+}
+
+void deviceTests()
+{
+    std::string error;
+    {
+        VirtualGamepad missing;
+        check(!missing.open(0, error, "/nonexistent/uinput") && !missing.isOpen() &&
+              error.find("/nonexistent/uinput") != std::string::npos, "missing uinput error");
+    }
+    std::size_t index;
+    {
+        VirtualGamepad pad;
+        check(pad.open(0, error, "/dev/null"), "open fake uinput");
+        {
+            std::lock_guard lock(fakeMutex);
+            index = devices.size() - 1;
+            const auto& d = devices[index];
+            check(d.created && d.setup.id.bustype == BUS_USB && d.setup.id.vendor == 0x045e &&
+                  d.setup.id.product == 0x028e && d.setup.id.version == 0x0114, "xpad identity");
+            check(std::string(d.setup.name) == "MiSTerCast Controller 1" && d.phys == "mistercast/pad0", "name/phys");
+            // Same key set as xpad's Xbox 360 pad so evdev button indices match SDL's mapping.
+            check(d.keys == std::set<int>{BTN_A, BTN_B, BTN_X, BTN_Y, BTN_TL, BTN_TR, BTN_SELECT,
+                                          BTN_START, BTN_MODE, BTN_THUMBL, BTN_THUMBR}, "advertised keys");
+            check(d.absbits == std::set<int>{ABS_X, ABS_Y, ABS_Z, ABS_RX, ABS_RY, ABS_RZ, ABS_HAT0X, ABS_HAT0Y},
+                  "advertised axes");
+            check(d.abs.at(ABS_X).minimum == -32768 && d.abs.at(ABS_X).maximum == 32767 &&
+                  d.abs.at(ABS_X).fuzz == 0 && d.abs.at(ABS_RZ).maximum == 255 &&
+                  d.abs.at(ABS_HAT0Y).minimum == -1, "axis ranges");
+        }
+        check(pad.apply({std::uint16_t(Button1 | Right), {5, 0, 0, 0}}, error), "apply");
+        check(pad.apply({std::uint16_t(Button1 | Right), {5, 0, 0, 0}}, error), "apply unchanged");
+        std::lock_guard lock(fakeMutex);
+        const auto& w = devices[index].writes;
+        check(w.size() == 1 && w[0].size() == 4, "one write per snapshot, nothing for repeats");
+        check(w[0].back().type == EV_SYN && w[0].back().code == SYN_REPORT, "SYN_REPORT terminates");
+    }
+    std::lock_guard lock(fakeMutex);
+    const auto& d = devices[index];
+    check(d.destroyed && d.writes.size() == 2 && has(d.writes[1], EV_KEY, BTN_A, 0) &&
+          has(d.writes[1], EV_ABS, ABS_HAT0X, 0) && has(d.writes[1], EV_ABS, ABS_X, 0), "close releases then destroys");
+}
+
+struct UdpServer {
+    int fd{-1};
+    sockaddr_in client{};
+    std::uint16_t port{};
+    UdpServer()
+    {
+        fd = ::socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) throw std::runtime_error("Mock UDP socket: " + std::string(std::strerror(errno)));
+        sockaddr_in address{};
+        address.sin_family = AF_INET;
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        check(::bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0, "UDP bind");
+        socklen_t length = sizeof(address);
+        check(::getsockname(fd, reinterpret_cast<sockaddr*>(&address), &length) == 0, "UDP address");
+        port = ntohs(address.sin_port);
+    }
+    ~UdpServer() { ::close(fd); }
+    void registration()
+    {
+        pollfd p{fd, POLLIN, 0};
+        check(::poll(&p, 1, 1000) > 0, "registration missing");
+        std::array<char, 8> bytes;
+        socklen_t length = sizeof(client);
+        check(::recvfrom(fd, bytes.data(), bytes.size(), 0, reinterpret_cast<sockaddr*>(&client), &length) == 1,
+              "registration must be one byte");
+    }
+    void send(const std::vector<std::uint8_t>& bytes)
+    {
+        check(::sendto(fd, bytes.data(), bytes.size(), 0, reinterpret_cast<sockaddr*>(&client), sizeof(client)) ==
+                  static_cast<ssize_t>(bytes.size()), "UDP packet send");
+    }
+};
+template <typename F> bool eventually(F condition, std::chrono::milliseconds limit = 1000ms)
+{
+    const auto deadline = Clock::now() + limit;
+    while (Clock::now() < deadline) {
+        {
+            std::lock_guard lock(fakeMutex);
+            if (condition()) return true;
+        }
+        std::this_thread::sleep_for(1ms);
+    }
+    return false;
+}
+std::size_t createdCount()
+{
+    std::lock_guard lock(fakeMutex);
+    return devices.size();
+}
+
+void receiverTests()
+{
+    UdpServer mister;
+    std::mutex mutex;
+    std::vector<std::string> warnings;
+    auto warn = [&](const std::string& m) { std::lock_guard lock(mutex); warnings.push_back(m); };
+    ControllerReceiver receiver;
+    std::string error;
+    check(!receiver.startGamepad("127.0.0.1", warn, error, mister.port, "/nonexistent/uinput"),
+          "start without uinput must fail synchronously");
+    for (unsigned session = 0; session < 3; ++session) {
+        const auto first = createdCount();
+        check(receiver.startGamepad("127.0.0.1", warn, error, mister.port, "/dev/null"), "gamepad startup");
+        mister.registration();
+        check(createdCount() == first + 1, "controller 1 created before any input");
+        const auto pad1 = first;
+        mister.send(packet(1, 1, Button1, 0));
+        check(eventually([&] { return !devices[pad1].writes.empty() && has(devices[pad1].writes.back(), EV_KEY, BTN_A, 1); }),
+              "controller 1 press forwarded");
+        check(createdCount() == first + 1, "neutral controller 2 must not create a pad");
+        // Duplicate, stale and malformed packets change nothing.
+        mister.send(packet(1, 1, 0, 0));
+        mister.send(packet(0, 9, 0, 0));
+        auto bad = packet(2, 1, 0, 0);
+        bad.push_back(0);
+        mister.send(bad);
+        const std::array<std::int8_t, 8> sticks{100, -50, 0, 0, 0, 0, 0, 0};
+        mister.send(packet(2, 1, Button1, Button2, &sticks));
+        check(eventually([&] { return devices.size() == first + 2 && !devices[pad1 + 1].writes.empty(); }),
+              "controller 2 created on first input");
+        {
+            std::lock_guard lock(fakeMutex);
+            const auto& w1 = devices[pad1].writes;
+            check(w1.size() == 2, "stale/duplicate/malformed packets were forwarded");
+            check(has(w1[1], EV_ABS, ABS_X, 25800) && has(w1[1], EV_ABS, ABS_Y, -12900) &&
+                  !has(w1[1], EV_KEY, BTN_A, 0), "analog forwarded, held button kept");
+            check(std::string(devices[pad1 + 1].setup.name) == "MiSTerCast Controller 2" &&
+                  has(devices[pad1 + 1].writes[0], EV_KEY, BTN_B, 1), "controller 2 press");
+        }
+        // Loopback forwarding latency (UDP receive to uinput write), informational.
+        std::vector<double> latencies;
+        for (unsigned i = 0; i < 200; ++i) {
+            std::size_t before;
+            {
+                std::lock_guard lock(fakeMutex);
+                before = devices[pad1].writes.size();
+            }
+            const auto sent = Clock::now();
+            mister.send(packet(3 + i, 1, (i & 1) ? Button3 : Button4, Button2));
+            check(eventually([&] { return devices[pad1].writes.size() > before; }), "latency packet forwarded");
+            std::lock_guard lock(fakeMutex);
+            latencies.push_back(std::chrono::duration<double, std::micro>(devices[pad1].writeTimes.back() - sent).count());
+        }
+        std::sort(latencies.begin(), latencies.end());
+        if (session == 0)
+            std::cout << "INFO loopback UDP->uinput latency p50/p99/max "
+                      << latencies[100] << "/" << latencies[198] << "/" << latencies.back() << " us\n";
+        const auto stopping = Clock::now();
+        receiver.stop();
+        receiver.stop();
+        check(Clock::now() - stopping < 100ms, "shutdown must be immediate");
+        std::lock_guard lock(fakeMutex);
+        check(devices[pad1].destroyed && devices[pad1 + 1].destroyed, "pads removed on stop");
+    }
+    std::lock_guard lock(mutex);
+    check(warnings.empty(), "unexpected warnings");
+}
