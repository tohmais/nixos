+bool ControllerReceiver::startGamepad(const std::string& host, Warning warning, std::string& error,
+                                      std::uint16_t port, const std::string& uinputPath)
+{
+    stop();
+    auto pads = std::make_unique<std::array<VirtualGamepad, 2>>();
+    if (!(*pads)[0].open(0, error, uinputPath)) return false;
+    Socket socket{openRegisteredSocket(host, port, error)};
+    if (socket.fd < 0) return false;
+    Socket wake{::eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC)};
+    if (wake.fd < 0) { error = "Cannot create controller wake-up descriptor: " + std::string(std::strerror(errno)); return false; }
+    try {
+        thread_ = std::jthread([fd = socket.fd, wakeFd = wake.fd, pads = std::move(pads), uinputPath,
+                                warning = std::move(warning)](std::stop_token stop) {
+            Socket udp{fd}, wakeUp{wakeFd};
+            // Block in poll() without a timeout: input is forwarded the moment it arrives
+            // and the thread costs nothing while idle. Stopping signals the eventfd.
+            std::stop_callback onStop(stop, [wakeFd] {
+                const std::uint64_t one = 1;
+                [[maybe_unused]] const auto n = ::write(wakeFd, &one, sizeof(one));
+            });
+            ControllerSequence sequence;
+            bool secondAttempted = false;
+            std::string message;
+            while (!stop.stop_requested()) {
+                std::array<pollfd, 2> fds{pollfd{udp.fd, POLLIN, 0}, pollfd{wakeUp.fd, POLLIN, 0}};
+                if (::poll(fds.data(), fds.size(), -1) < 0 && errno != EINTR) {
+                    warning("Controller poll failed: " + std::string(std::strerror(errno)));
+                    return;
+                }
+                // Cap each drain so a UDP flood cannot starve shutdown.
+                for (unsigned packets = 0; packets < 64 && !stop.stop_requested(); ++packets) {
+                    std::array<std::uint8_t, 18> bytes{};
+                    const auto n = ::recv(udp.fd, bytes.data(), bytes.size(), MSG_DONTWAIT | MSG_TRUNC);
+                    if (n < 0) {
+                        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) break;
+                        // A connected UDP socket reports ICMP errors (e.g. MiSTer not yet
+                        // listening) here; they are transient, so keep the pads alive.
+                        if (errno == ECONNREFUSED) continue;
+                        warning("Controller UDP receive failed: " + std::string(std::strerror(errno)));
+                        return;
+                    }
+                    if (n != 9 && n != 17) continue;
+                    const auto packet = decodeControllerPacket(std::span(bytes).first(static_cast<std::size_t>(n)));
+                    if (!packet || !sequence.accept(*packet, ControllerSequence::Clock::now())) continue;
+                    for (unsigned c = 0; c < 2; ++c) {
+                        auto& pad = (*pads)[c];
+                        const auto state = gamepadState(*packet, c);
+                        if (!pad.isOpen()) {
+                            // Only create controller 2 once it is actually used, so games
+                            // do not see a phantom second pad.
+                            if (c == 0 || secondAttempted || state == GamepadState{}) continue;
+                            secondAttempted = true;
+                            if (!pad.open(1, message, uinputPath)) { warning(message); continue; }
+                        }
+                        if (!pad.apply(state, message)) { warning(message); pad.close(); }
+                    }
+                }
+            }
+        });
+        socket.fd = -1; // Worker owns the descriptors only after construction succeeds.
+        wake.fd = -1;
+    } catch (const std::exception& exception) {
+        error = "Cannot start controller worker: " + std::string(exception.what());
+        return false;
+    }
+    return true;
+}
 } // namespace mistercast
