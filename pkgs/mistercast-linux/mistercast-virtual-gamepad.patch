diff --git a/src/input/VirtualGamepad.cpp b/src/input/VirtualGamepad.cpp
new file mode 100644
index 0000000..4247e8d
--- /dev/null
+++ b/src/input/VirtualGamepad.cpp
@@ -0,0 +1,154 @@
+#include "input/VirtualGamepad.h"
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/uinput.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+namespace mistercast {
+namespace {
+using namespace controller_button;
+struct ButtonBinding { std::uint16_t mask; std::uint16_t code; };
+// xpad reports the left face button as BTN_X and the top one as BTN_Y; SDL's
+// Xbox 360 mapping and Proton expect exactly that, so mirror it.
+constexpr std::array buttonBindings{
+    ButtonBinding{Button1, BTN_A},       ButtonBinding{Button2, BTN_B},
+    ButtonBinding{Button3, BTN_X},       ButtonBinding{Button4, BTN_Y},
+    ButtonBinding{Button5, BTN_SELECT},  ButtonBinding{Button6, BTN_START},
+    ButtonBinding{LeftShoulder, BTN_TL}, ButtonBinding{RightShoulder, BTN_TR},
+};
+// The full xpad key set must be advertised so evdev button indices line up with
+// the Xbox 360 mapping (guide and stick clicks have no Groovy equivalent).
+constexpr std::array advertisedKeys{
+    BTN_A, BTN_B, BTN_X, BTN_Y, BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_MODE, BTN_THUMBL, BTN_THUMBR,
+};
+constexpr std::array stickAxes{ABS_X, ABS_Y, ABS_RX, ABS_RY};
+constexpr std::int32_t TriggerMax = 255;
+
+int hatX(std::uint16_t b) { return int((b & Right) != 0) - int((b & Left) != 0); }
+int hatY(std::uint16_t b) { return int((b & Down) != 0) - int((b & Up) != 0); }
+std::int32_t stick(std::int8_t v) { return std::clamp(std::int32_t{v} * 258, -32768, 32767); }
+void push(std::vector<input_event>& events, std::uint16_t type, std::uint16_t code, std::int32_t value)
+{
+    input_event e{};
+    e.type = type;
+    e.code = code;
+    e.value = value;
+    events.push_back(e);
+}
+}
+
+GamepadState gamepadState(const ControllerPacket& packet, unsigned controller)
+{
+    GamepadState state;
+    state.buttons = packet.buttons[controller];
+    // Digital-only snapshots centre the sticks rather than freezing stale values.
+    if (packet.hasAnalog)
+        for (unsigned i = 0; i < state.axes.size(); ++i) state.axes[i] = packet.analog[controller * 4 + i];
+    return state;
+}
+
+void appendGamepadEvents(const GamepadState& from, const GamepadState& to, std::vector<input_event>& events)
+{
+    const auto changed = std::uint16_t(from.buttons ^ to.buttons);
+    for (const auto& b : buttonBindings)
+        if (changed & b.mask) push(events, EV_KEY, b.code, (to.buttons & b.mask) ? 1 : 0);
+    if (changed & Button9) push(events, EV_ABS, ABS_Z, (to.buttons & Button9) ? TriggerMax : 0);
+    if (changed & Button10) push(events, EV_ABS, ABS_RZ, (to.buttons & Button10) ? TriggerMax : 0);
+    if (hatX(from.buttons) != hatX(to.buttons)) push(events, EV_ABS, ABS_HAT0X, hatX(to.buttons));
+    if (hatY(from.buttons) != hatY(to.buttons)) push(events, EV_ABS, ABS_HAT0Y, hatY(to.buttons));
+    for (unsigned i = 0; i < stickAxes.size(); ++i)
+        if (from.axes[i] != to.axes[i]) push(events, EV_ABS, stickAxes[i], stick(to.axes[i]));
+}
+
+bool ControllerSequence::accept(const ControllerPacket& p, Clock::time_point now)
+{
+    if (have_ && now - lastAccepted_ < Rebaseline) {
+        const auto delta = std::uint32_t(p.frame - last_.frame);
+        if ((delta == 0 && p.order <= last_.order) || delta >= 0x80000000u) return false;
+    }
+    last_ = p;
+    lastAccepted_ = now;
+    have_ = true;
+    return true;
+}
+
+VirtualGamepad::~VirtualGamepad() { close(); }
+
+bool VirtualGamepad::open(unsigned index, std::string& error, const std::string& path)
+{
+    close();
+    fd_ = ::open(path.c_str(), O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd_ < 0) {
+        error = "Cannot open " + path + ": " + std::strerror(errno) +
+            (errno == EACCES || errno == EPERM
+                 ? "; give your user write access to it (for example the uinput group)" : "");
+        return false;
+    }
+    auto fail = [&](const char* what) {
+        error = std::string("Cannot create virtual gamepad (") + what + "): " + std::strerror(errno);
+        ::close(fd_);
+        fd_ = -1;
+        return false;
+    };
+    if (::ioctl(fd_, UI_SET_EVBIT, EV_KEY) < 0) return fail("EV_KEY");
+    for (auto key : advertisedKeys)
+        if (::ioctl(fd_, UI_SET_KEYBIT, key) < 0) return fail("key");
+    if (::ioctl(fd_, UI_SET_EVBIT, EV_ABS) < 0) return fail("EV_ABS");
+    auto axis = [&](std::uint16_t code, std::int32_t min, std::int32_t max, std::int32_t flat) {
+        uinput_abs_setup setup{};
+        setup.code = code;
+        setup.absinfo.minimum = min;
+        setup.absinfo.maximum = max;
+        setup.absinfo.flat = flat; // fuzz stays 0: no kernel smoothing between snapshots
+        return ::ioctl(fd_, UI_SET_ABSBIT, code) >= 0 && ::ioctl(fd_, UI_ABS_SETUP, &setup) >= 0;
+    };
+    for (auto code : stickAxes)
+        if (!axis(code, -32768, 32767, 128)) return fail("stick axis");
+    if (!axis(ABS_Z, 0, TriggerMax, 0) || !axis(ABS_RZ, 0, TriggerMax, 0)) return fail("trigger axis");
+    if (!axis(ABS_HAT0X, -1, 1, 0) || !axis(ABS_HAT0Y, -1, 1, 0)) return fail("d-pad axis");
+    const auto phys = "mistercast/pad" + std::to_string(index);
+    if (::ioctl(fd_, UI_SET_PHYS, phys.c_str()) < 0) return fail("phys");
+    uinput_setup setup{};
+    setup.id.bustype = BUS_USB;
+    setup.id.vendor = Vendor;
+    setup.id.product = Product;
+    setup.id.version = Version;
+    const auto name = "MiSTerCast Controller " + std::to_string(index + 1);
+    std::strncpy(setup.name, name.c_str(), sizeof(setup.name) - 1);
+    if (::ioctl(fd_, UI_DEV_SETUP, &setup) < 0) return fail("setup");
+    if (::ioctl(fd_, UI_DEV_CREATE) < 0) return fail("create");
+    state_ = {};
+    return true;
+}
+
+bool VirtualGamepad::apply(const GamepadState& state, std::string& error)
+{
+    if (fd_ < 0) return false;
+    events_.clear();
+    appendGamepadEvents(state_, state, events_);
+    if (events_.empty()) return true;
+    push(events_, EV_SYN, SYN_REPORT, 0);
+    const auto bytes = events_.size() * sizeof(input_event);
+    const auto n = ::write(fd_, events_.data(), bytes);
+    if (n != static_cast<ssize_t>(bytes)) {
+        error = "Virtual gamepad write failed: " + std::string(n < 0 ? std::strerror(errno) : "short write");
+        return false;
+    }
+    state_ = state;
+    return true;
+}
+
+void VirtualGamepad::close()
+{
+    if (fd_ < 0) return;
+    std::string ignored;
+    apply({}, ignored);
+    ::ioctl(fd_, UI_DEV_DESTROY);
+    ::close(fd_);
+    fd_ = -1;
+    state_ = {};
+}
+} // namespace mistercast
