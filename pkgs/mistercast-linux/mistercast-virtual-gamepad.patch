+#pragma once
+#include "input/ControllerInput.h"
+#include <linux/input.h>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace mistercast {
+// One Groovy controller slot, as reported in a single input snapshot.
+struct GamepadState {
+    std::uint16_t buttons{};            // GM_JOY_* bitmask
+    std::array<std::int8_t, 4> axes{};  // LX, LY, RX, RY; 0 is centred
+    bool operator==(const GamepadState&) const = default;
+};
+GamepadState gamepadState(const ControllerPacket& packet, unsigned controller);
+
+// Appends the evdev events that move a pad from `from` to `to`, without SYN_REPORT.
+// Layout follows RetroArch's mister_joypad convention by position: Button 1 is the
+// bottom face button, 2 right, 3 left, 4 top, 5/6 Select/Start, 7/8 L/R, 9/10 L2/R2.
+void appendGamepadEvents(const GamepadState& from, const GamepadState& to,
+                         std::vector<input_event>& events);
+
+// Accepts only newer snapshots (the same frame/order rule as ControllerInput).
+// After a quiet gap any snapshot is accepted, so an event-order wrap or a MiSTer
+// counter reset cannot freeze the pad.
+class ControllerSequence {
+public:
+    using Clock = ControllerInput::Clock;
+    static constexpr auto Rebaseline = std::chrono::seconds(1);
+    bool accept(const ControllerPacket& packet, Clock::time_point now);
+private:
+    ControllerPacket last_{};
+    Clock::time_point lastAccepted_{};
+    bool have_{};
+};
+
+// A uinput device with the kernel xpad driver's Xbox 360 identity and layout, so
+// SDL, Wine/Proton and Steam apply their built-in mappings without configuration.
+class VirtualGamepad {
+public:
+    static constexpr std::uint16_t Vendor = 0x045e, Product = 0x028e, Version = 0x0114;
+    VirtualGamepad() = default;
+    VirtualGamepad(const VirtualGamepad&) = delete;
+    VirtualGamepad& operator=(const VirtualGamepad&) = delete;
+    ~VirtualGamepad();
+    bool open(unsigned index, std::string& error, const std::string& path = "/dev/uinput");
+    // One write() per change: all events of a snapshot plus SYN_REPORT.
+    bool apply(const GamepadState& state, std::string& error);
+    bool isOpen() const { return fd_ >= 0; }
+    // Releases everything, then removes the device.
+    void close();
+private:
+    int fd_{-1};
+    GamepadState state_{};
+    std::vector<input_event> events_;
+};
+} // namespace mistercast
