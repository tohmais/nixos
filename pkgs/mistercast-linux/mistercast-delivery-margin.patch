 namespace mistercast {
 
+// Minimum delivery reserve (lines between BLIT arrival and scan-out). Starts at
+// half a frame and steps down while the FPGA reports clean frames, until the
+// measured transfer requirement in calculateDeliverySyncLine() dominates. Every
+// reserve line is a line of display latency.
 class AdaptiveDeliveryMargin {
 public:
-    static constexpr std::uint32_t kHealthySamplesPerStep = 300;
+    static constexpr std::uint32_t kHealthySamplesPerStep = 30;
     static constexpr std::uint16_t kLinesPerStep = 4;
+    static constexpr std::uint16_t kBackoffLines = 32;
+    // A failure raises a floor just above where it happened; after this many
+    // clean samples the floor relaxes one step so a one-off stall is forgotten.
+    static constexpr std::uint32_t kFloorDecaySamples = 1800;
+    // An empty VRAM queue at ACK time is routine (observed about once per
+    // 140 frames at a half-frame reserve with no frame skips). Only a burst of
+    // them within one window is treated as pressure.
+    static constexpr std::uint32_t kQueueWindowSamples = 120;
+    static constexpr std::uint32_t kQueueEmptyPressure = 6;
 
     explicit AdaptiveDeliveryMargin(const Modeline& mode = kDefaultModeline);
 
     void reset(const Modeline& mode);
-    void observe(const FpgaStatus& status);
+    // effectiveLines is the reserve the last BLIT actually used (it can exceed
+    // minimumLines() when the measured requirement is larger); 0 if unknown.
+    void observe(const FpgaStatus& status, std::uint16_t effectiveLines = 0);
     [[nodiscard]] std::uint16_t minimumLines() const { return currentLines_; }
+    [[nodiscard]] std::uint16_t floorLines() const { return learnedFloorLines_; }
 
 private:
     std::uint16_t conservativeLines_{};
     std::uint16_t floorLines_{};
+    std::uint16_t learnedFloorLines_{};
     std::uint16_t currentLines_{};
     std::uint32_t healthySamples_{};
+    std::uint32_t samplesSinceFailure_{};
+    std::uint32_t queueWindowSamples_{};
+    std::uint32_t queueEmptySamples_{};
 };
 
